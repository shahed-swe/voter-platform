# Reverse proxy + automatic HTTPS for the Voter Management Platform.
#
# SITE_ADDRESS decides how Caddy provisions the certificate — no other change
# needed to go from local to production:
#
#   • local dev   → SITE_ADDRESS=localhost         (Caddy's internal self-signed CA)
#   • bare IP     → SITE_ADDRESS=https://153.75.230.154   (internal self-signed CA;
#                                                    browser warning, but a real
#                                                    HTTPS "secure context" so the
#                                                    Geolocation API works)
#   • real domain → SITE_ADDRESS=vote.example.com   (automatic Let's Encrypt cert)
#
# In every case Caddy terminates TLS and forwards to the Express server on :3000.

{
	# Email used for Let's Encrypt when SITE_ADDRESS is a public domain.
	# Harmless for localhost / internal certs.
	email {$ACME_EMAIL:admin@example.com}
}

{$SITE_ADDRESS:localhost} {
	encode gzip
	reverse_proxy server:3000
}
