# =========================================================
# Top-level env for docker compose (voter-platform/.env)
# Copy this file to .env at the repo root and edit as needed.
# =========================================================

# ---- Postgres (used by both `postgres` and `server` services) ----
POSTGRES_USER=voter
POSTGRES_PASSWORD=voter
POSTGRES_DB=voter_platform
POSTGRES_PORT=5434

# The Postgres database the *application* reads/writes. Defaults to the new
# multi-tenant DB. The legacy single-tenant `voter_platform` DB is preserved
# untouched as a fallback — switch back by setting APP_DATABASE=voter_platform.
APP_DATABASE=voter_platform_mt

# ---- Server ----
PORT=3000
NODE_ENV=production
TENANT_ID=dhaka13
TENANT_NAME=Dhaka-13 Survey Platform
TENANT_PUBLIC_URL=http://localhost:3000

JWT_SECRET=change-me-in-production
JWT_EXPIRY=7d
BCRYPT_ROUNDS=10

# Leave empty in dev. Comma-separated origin list in prod.
ALLOWED_ORIGINS=

# ---- Email (Gmail / SMTP) ----
EMAIL_ENABLED=false
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ---- SMS (BulkSMSBD) ----
SMS_ENABLED=false
SMS_API_URL=http://bulksmsbd.net/api/smsapi
SMS_API_KEY=
SMS_SENDER_ID=

# ---- Uploads ----
MAX_UPLOAD_BYTES=52428800
