# ==================== APPLICATION ====================
NODE_ENV=development
PORT=3000

# ==================== TENANT ====================
# Identifies the deployment instance. Used in branding, URLs, JWT secret namespace.
# Examples: dhaka13, panchagarh
TENANT_ID=dhaka13
TENANT_NAME=Dhaka-13 Survey Platform
TENANT_PUBLIC_URL=https://analytixbd.com/dhaka13

# ==================== POSTGRESQL ====================
DATABASE_URL=postgres://postgres:postgres@localhost:5432/voter_platform
PGSSL=false
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000

# ==================== AUTH ====================
JWT_SECRET=change-me-in-production
JWT_EXPIRY=7d
BCRYPT_ROUNDS=10

# ==================== CORS ====================
# Comma separated list; leave empty to allow all (dev)
ALLOWED_ORIGINS=

# ==================== EMAIL (Gmail / SMTP) ====================
EMAIL_ENABLED=false
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Info <info@example.com>"

# ==================== SMS (BulkSMSBD) ====================
SMS_ENABLED=false
SMS_API_URL=http://bulksmsbd.net/api/smsapi
SMS_API_KEY=
SMS_SENDER_ID=

# ==================== UPLOADS ====================
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=52428800

# ==================== CACHE ====================
FILTER_CACHE_TTL_MS=3600000
